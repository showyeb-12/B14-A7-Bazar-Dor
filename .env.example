# ── API ────────────────────────────────────────────────
# Primary product API (programming-hero)
NEXT_PUBLIC_API_URL=https://openapi.programming-hero.com/api/bazardor
# Alternative mirror (used automatically if the primary fails)
NEXT_PUBLIC_API_URL_ALT=https://api.api-store.workers.dev/api/bazardor

# ── BetterAuth ─────────────────────────────────────────
# Generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Database used by BetterAuth (SQLite file for local dev).
# For serverless (Vercel) point this at a hosted DB and add the matching driver.
DATABASE_URL=./bazardor.db

# ── OAuth (optional) ───────────────────────────────────
# Without these the social buttons show a friendly error toast.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
